# Superpowers brainstorming/planning artifacts — local-only, never committed.
# Specs and plans live on the developer's machine; the public repo contains
# only plugins and their docs.
docs/superpowers/

# Serena MCP cache
.serena/

# issue-to-pr per-task working dirs (worktree-local: progress.md, design.md, state.json)
tmp/task-*/

# Python bytecode — the humanizer plugin vendors a scanner that generates it on run
__pycache__/
*.pyc

# Local behavioral eval reports and transcripts
plugins/issue-to-pr/evals/results/
